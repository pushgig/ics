{
  "name": "pushgig-ics",
  "version": "0.1.0",
  "description": "iCal (.ics) generator with full support for timezones",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b --incremental",
    "prepare": "tsc",
    "prepublish": "tsc",
    "test": "vitest run",
    "ci": "yarn build && yarn test",
    "prettier:check": "prettier --check '**/*.{js,ts,graphql}'",
    "prettier:format": "prettier --write --config ./.prettierrc \"**/*.{js,ts,graphql,md}\""
  },
  "repository": {
    "git": "https://github.com/pushgig/ics"
  },
  "author": "John French <john.french@pushgig.com>",
  "license": "MIT",
  "dependencies": {
    "luxon": "^1.27.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "prettier": "^2.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
